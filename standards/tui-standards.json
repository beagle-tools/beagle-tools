{
  "keymap": [
    {"job": "Move", "keys": ["j", "k", "g", "G", "ctrl-d", "ctrl-u"], "doc": "`j`/`k` or `↑`/`↓`, `g`/`G` top/bottom, `ctrl-d`/`ctrl-u` page"},
    {"job": "Open / back", "keys": ["Enter", "Esc", "b"], "doc": "`Enter` open; `Esc` or `b` back (`h`/`l` and arrows stay free per TUI)"},
    {"job": "Tabs", "keys": ["Tab", "]", "["], "doc": "`Tab`, `]` and `[` cycle tabs (and `1`–`9` jump)"},
    {"job": "Help / quit", "keys": ["?", "q", "Q"], "doc": "`?` help; `q` and `Q` quit; any key closes help"},
    {"job": "Reload", "keys": ["r"], "doc": "`r`"},
    {"job": "Search", "keys": ["/"], "doc": "`/`"},
    {"job": "Open in browser", "keys": ["o"], "doc": "`o`"},
    {"job": "Edit", "keys": ["E"], "doc": "`E`"},
    {"job": "Copy", "keys": ["y", "Y", "i"], "doc": "`y` line or selection, `Y` URL, `i` id"},
    {"job": "Resize side pane", "keys": ["w"], "doc": "`w` (above)"}
  ],
  "github_writes": [
    {"key": "A", "action": "approve"},
    {"key": "M", "action": "merge"},
    {"key": "P", "action": "post/publish"},
    {"key": "D", "action": "ready↔draft"},
    {"key": "X", "action": "close"}
  ],
  "tui_github_writes": {
    "recap/tui": ["D", "M", "X"],
    "tandem/lib/queue": ["A", "P"]
  },
  "tuis": {
    "rca/tui": "rca/tui/src/ui/tests/keys_standard.rs",
    "recap/tui": "recap/tui/src/tests/ui_keymap.rs",
    "scout/tui": "scout/tui/src/ui/keys_tests.rs",
    "standup/tui": "standup/tui/src/tests/ui_keymap.rs",
    "tandem/lib/queue": "tandem/lib/queue/src/ui/tests.rs",
    "agent/lib/top": "agent/lib/top/src/tests/keymap.rs"
  },
  "not_tuis": {
    "utils/tui": "the shared crate itself",
    "beagle": "uses only the release picker behind `beagle version list`",
    "beagle/serve": "an HTTPS API, no terminal UI"
  }
}
