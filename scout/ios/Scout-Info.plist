<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE). Only what
     build settings can't express lives here: the beagle:// URL scheme, so a QR
     code scanned with the Camera app opens the pairing screen. -->
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.beagletools.scout.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>beagle</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
