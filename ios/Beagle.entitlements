<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Push Notifications (docs/serve-push.md). No team ID: signing stays
     automatic, and it turns Push on for the App ID when it makes the profile.
     Archives for TestFlight/App Store are re-signed with production. -->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
